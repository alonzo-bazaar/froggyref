#!./tools/shsl
;; -*- mode:clojure -*-
;; vi: set ft=clojure:

;; note: this currently kinda only works on linux, for *several* reasons
;; I may port the build part to windows as well some day but it's not cross
;; platform mostly due to limitations of the interpreter I'm writing this
;; build script with (I made the interpreter myself lol)

;; config shit
(def log-cmds? true)
(def fuck-dlls? false) ;; for now

;; utils (that I should add to shsl's stdlib already)
(defmacro if-not [a b & c]
  (if-code (not-code a)
           b
           (if (= c []) nil (get c 0))))
(defn file? [file]
  (= 0 (:exit-code (exec-strs "ls" file))))
(defn die [& msg]
  (map print (if (= [] msg) ["fuck"] msg)) (println "")
  (exit 1))
(defn exec-or-die [& cmd]
  (let [cmd (reduce vec-cat (map (fn [x] (if (vec? x) x [x])) cmd))]
    (if log-cmds? (println "running command: " cmd))
    (or (exec-vec cmd) (die))))
(defn mkdir [a]
  (if-not (file? a)
    (exec-or-die "mkdir" "-p" a)))
(defn rm [a]
  (if (file? a)
    (exec-or-die "rm" "-f" a)))

;; data that is of interest to more or less the entire build script
(def linux-tarball-url
  (str "https://github.com/raysan5/raylib/releases/download/5.5/"
       "raylib-5.5_linux_amd64.tar.gz"))
(def arch "x86_64-pc-linux-gnu") ;; TODO: this is techincally arch and os :|
(def claw-raylib-url "https://github.com/bohonghuang/claw-raylib.git")
(def raylib-dir "thirdparty/raylib-5.5_linux_amd64")
(def claw-dir   "thirdparty/claw-raylib")

;; make dirs if need
(mkdir "thirdparty") ;; here be vendored shit (deps)
(mkdir "build")      ;; here be built shit (libs & exe)
(mkdir "build/lib")

;; download raylib to thirdparty if not present
(if-not (file? "thirdparty/raylib.tar.gz")
  (exec-or-die "curl"
               "-L" linux-tarball-url
               "-o" "thirdparty/raylib.tar.gz"))

(if-not (file? "thirdparty/raylib-5.5_linux_amd64")
  (exec-or-die "tar" "-xf"
               "thirdparty/raylib.tar.gz"
               "-C" "thirdparty"))

;; this will have to be thoroughly cross platorfm-d later
;; but, at the moment we kinda fucking eh
;; long story short, fuck shared libraries
(when fuck-dlls?
  (rm (str raylib-dir "/lib/libraylib.so"))
  (rm (str raylib-dir "/libraylib.so.5.5.0"))
  (rm (str raylib-dir "/libraylib.so.550")))

;; claw raylib expects raymath.h and rcamera.h as well as raylib.h
;; for whatever fucking reason
;; so... fuck it
(if-not (file? (str raylib-dir "/include/raymath.h"))
  (exec-or-die "curl"
               "-L" "https://raw.githubusercontent.com/raysan5/raylib/refs/tags/5.5/src/raymath.h"
               "-o" (str raylib-dir "/include/raymath.h")))

(if-not (file? (str raylib-dir "/include/rcamera.h"))
  (exec-or-die "curl"
               "-L" "https://raw.githubusercontent.com/raysan5/raylib/refs/tags/5.5/src/rcamera.h"
               "-o" (str raylib-dir "/include/rcamera.h")))

;; download claw-raylib
(if-not (file? "thirdparty/claw-raylib")
  (exec-or-die "git" "clone" claw-raylib-url
               "-b" "prebuild-5.5"
               "thirdparty/claw-raylib"))

;; adapted from claw-raylib repo README
;; (I don't care about raygui atm)
;; we to link statically against raylib, LD_LIBRARY_PATH can *suck my dick*
(defn compile-claw-for-arch [arch]
  (map

    (fn [lib]
      (let [bin (str claw-dir"/lib/" "lib" lib "-adapter.so")
            src (str claw-dir"/lib/" "lib" lib "-adapter." arch ".c")]
        (if-not (file? bin)
          (exec-or-die
            "gcc" "-O3" "-fPIC" "-shared"
            (str "-I./"  raylib-dir "/include/")
            (str "-L./"  raylib-dir "/lib/")
            "-lraylib"
            src
            "-o" bin
            ))))

      ["raylib" "rlgl"]))

(compile-claw-for-arch arch)
